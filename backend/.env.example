# --- D1: Cognee mode (BuildSpec §10) ---
# cloud = Cognee Cloud managed backend (COGNEE_SERVICE_URL/COGNEE_API_KEY)
# local = self-hosted SDK, file-based default stores (kuzu/ladybug graph, lancedb vector, sqlite relational)
COGNEE_MODE=local

# --- Cognee Cloud (only used when COGNEE_MODE=cloud) ---
COGNEE_SERVICE_URL=
COGNEE_API_KEY=

# --- D2: LLM for cognify + interview agent ---
# Primary: Groq (fast, free-tier friendly). Cognee routes Groq through LiteLLM
# via the "groq/" model prefix; LLM_PROVIDER=custom, no LLM_ENDPOINT needed.
# Confirmed against docs.cognee.ai/setup-configuration/llm-providers (2026-07-04).
LLM_PROVIDER=custom
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_API_KEY=

# --- Fallback: Cloudflare Workers AI ---
# LiteLLM's Cloudflare handler reads CLOUDFLARE_API_KEY / CLOUDFLARE_ACCOUNT_ID
# directly from the environment (not from the generic LLM_API_KEY passthrough),
# so both must be set here even though cognee itself only asks for LLM_API_KEY.
# To switch: set LLM_MODEL=cloudflare/@cf/meta/llama-3.1-8b-instruct below and
# fill in these two.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- local-mode storage roots (only used when COGNEE_MODE=local) ---
# NOTE: cognee validates these as absolute paths — relative/blank values raise
# a pydantic ValidationError at import time (confirmed in the hour-1 spike).
# Leave blank to let config.py default to <repo>/backend/.cognee_data(/system).
DATA_ROOT_DIRECTORY=
SYSTEM_ROOT_DIRECTORY=
